# ==============================================================================
# Environment Configuration
# ==============================================================================
# Set to 'development' for SQLite local development
# Set to 'production' for PostgreSQL production deployment
# Set to 'testing' for in-memory SQLite automated test suite
ENVIRONMENT=production

# Optional debug flag (defaults to True in development, False in production)
DEBUG=True

# ==============================================================================
# Security Configuration
# ==============================================================================
SECRET_KEY=vPTCnlf_1ICUPXSOsuUmFlldYXanuCzMw9pLsHJAHtK-ynGK4-oDs037f9xUkGeP4WmXfBXqOL7AWKwyq105Cw
