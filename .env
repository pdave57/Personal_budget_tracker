# ==============================================================================
# Environment Configuration
# ==============================================================================
# Set to 'development' for SQLite local development
# Set to 'production' for PostgreSQL production deployment
# Set to 'testing' for in-memory SQLite automated test suite
ENVIRONMENT=production

# Optional debug flag (defaults to True in development, False in production)
DEBUG=True

# ==============================================================================
# Security Configuration
# ==============================================================================
SECRET_KEY=vPTCnlf_1ICUPXSOsuUmFlldYXanuCzMw9pLsHJAHtK-ynGK4-oDs037f9xUkGeP4WmXfBXqOL7AWKwyq105Cw
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==============================================================================
# Development Database (SQLite)
# ==============================================================================
# Used automatically when ENVIRONMENT=development
# Default: sqlite:///./budget_tracker.db
DATABASE_URL=sqlite:///./budget_tracker.db
SQLITE_DB_PATH=./budget_tracker.db

# ==============================================================================
# Production Database (PostgreSQL)
# ==============================================================================
# Used automatically when ENVIRONMENT=production
# Option A: Full Connection String (e.g. from AWS RDS, Render, Neon, Supabase)
#DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/budget_tracker

# Option B: Individual PostgreSQL Connection Parameters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1q2w3e*
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=budget_tracker

# Production Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
DB_ECHO=False

